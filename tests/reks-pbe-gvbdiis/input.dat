#! Manual test -- not generated by zvalide.
#! Test: reks-pbe-gvbdiis
#! REKS(2,2)/6-31G on H2 with pure functionals, which ask the JK object for neither
#! K nor wK. GVB-DIIS needs the pair integrals (pk|pk) for its curvature, so
#! build_jk_cache builds them from the active columns on demand. Three invariants:
#!   (1) the on-demand exchange pass does not disturb the Coulomb-only Fock: the
#!       accelerator sits in the step denominator, so both DIIS formulations land
#!       on the E_sa of the plain path.
#!   (2) neither formulation costs iterations against that path.
#!   (3) SVWN covers the case where the pair-ERI pass pushes exactly as many
#!       densities as the Fock pass: no core orbital, and no closed-shell G density
#!       either, since that one is built only for a GGA. A JK object that sizes its
#!       outputs off the J task alone then hands back no exchange matrices at all.
#!   (4) M06-L carries the same invariant onto the meta-GGA XC machinery.
import psi4

REF_E_SA = -0.9268462670834844  #TEST
REF_N_ITER = 10  #TEST
REF_E_SA_LDA = -0.9398877331047841  #TEST
REF_E_SA_MGGA = -0.9205152815440000  #TEST
ATOL_E = 1.0e-7  #TEST

OPTS = {
    'basis': '6-31g',
    'scf_type': 'pk',
    'reference': 'reks',
    'df_scf_guess': False,
    'maxiter': 50,
    'e_convergence': 8,
    'd_convergence': 6,
    'dft_grid_name': 'SG1',
    'guess': 'SAD',
    'reks': [2, 2],
    'reks_sa_weights': [0.5, 0.5],
    'reks_report_level': 4,
    'fail_on_maxiter': False,
}


def make_mol():
    return psi4.geometry("""
    0 1
    H  0.0  0.0  0.0
    H  0.0  0.0  1.600000
    symmetry c1
    no_com
    no_reorient
    """)


def run(functional='pbe', **over):
    psi4.core.clean()
    make_mol()
    psi4.set_options(dict(OPTS, **over))
    e_sa, wfn = psi4.energy(functional, return_wfn=True)
    return e_sa, wfn.iteration_


# (1) plain REKS with a pure functional converges.
e_sa, n_iter = run(reks_gvb_diis=False)
compare_values(REF_E_SA, e_sa, ATOL_E, "PBE REKS(2,2) E_sa")  #TEST
compare_integers(REF_N_ITER, n_iter, "PBE REKS(2,2) n_iter")  #TEST

# (2) both GVB-DIIS formulations reach the same E_sa, none of them slower.
for formulation in ('CFM', 'ORBITAL'):
    e_gvb, n_gvb = run(reks_gvb_diis=True, reks_diis_formulation=formulation)
    compare_values(REF_E_SA, e_gvb, ATOL_E,
                   f"PBE REKS(2,2) E_sa, GVB-DIIS/{formulation}")  #TEST
    compare_integers(1, int(n_gvb <= REF_N_ITER),
                     f"PBE REKS(2,2) GVB-DIIS/{formulation} n_iter <= plain")  #TEST

# (3) LDA: pair-ERI density count equal to the Fock pass count.
e_lda, _ = run('svwn', reks_gvb_diis=False)
compare_values(REF_E_SA_LDA, e_lda, ATOL_E, "SVWN REKS(2,2) E_sa")  #TEST
e_lda_gvb, _ = run('svwn', reks_gvb_diis=True)
compare_values(REF_E_SA_LDA, e_lda_gvb, ATOL_E, "SVWN REKS(2,2) E_sa, GVB-DIIS")  #TEST

# (4) meta-GGA.
e_mgga, _ = run('m06-l', reks_gvb_diis=False)
compare_values(REF_E_SA_MGGA, e_mgga, ATOL_E, "M06-L REKS(2,2) E_sa")  #TEST
e_mgga_gvb, _ = run('m06-l', reks_gvb_diis=True)
compare_values(REF_E_SA_MGGA, e_mgga_gvb, ATOL_E, "M06-L REKS(2,2) E_sa, GVB-DIIS")  #TEST
psi4.core.clean()
