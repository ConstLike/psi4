def make_mol(R):
    # charge 0. Multiplicity: canonical Ms (even-N: 1, odd-N: 2).
    _reks = OPTS['reks']
    _mult = 1 if _reks[0] % 2 == 0 else 2
    lines = [f"0 {_mult}"]
    for i in range(N_ATOMS):
        lines.append(f"H  0.0  0.0  {i * R:.6f}")
    lines.append("symmetry c1")
    return psi4.geometry("\n".join(lines))


def _n_sectors(wfn):
    if wfn.has_scalar_variable("REKS N SECTORS"):
        return int(round(wfn.scalar_variable("REKS N SECTORS")))
    return 1


def _sec_name(s, base):
    # Mirror of runtime sector_psivar_name: s==0 -> base; s>0 ->
    # "REKS SECTOR s " + (base minus leading "REKS ").
    if s == 0:
        return base
    tail = base[5:] if base.startswith("REKS ") else base
    return f"REKS SECTOR {s} {tail}"


def _sec_pfx(s, pfx):
    return pfx if s == 0 else f"s{s}_{pfx}"


def _sector_of_K(wfn, K, n_sec):
    for s in range(n_sec):
        if wfn.has_array_variable(_sec_name(s, f"SSR ENERGIES K={K}")):
            return s
    return 0


def _si_K_list(wfn):
    if not wfn.has_array_variable("SSR SI LIST"):
        return []
    return [int(round(x)) for x in wfn.array_variable("SSR SI LIST").np.flatten()]


def _si_overlap(wfn, s, K, n):
    """Dense S from the sparse (flat index, value) export. The runtime stores S by its
    nonzeros -- the 0.4 to 5 percent of the grid the catalog pairs reach -- so the dense
    form is rebuilt here, where n is small, instead of being carried through the run."""
    nm = _sec_name(s, f"SSR OVERLAP SPARSE K={K}")
    if not wfn.has_array_variable(nm):
        return None
    coo = wfn.array_variable(nm).np
    S = np.zeros((n, n))
    for row in range(coo.shape[0]):
        flat = int(round(float(coo[row, 0])))
        S[flat // n, flat % n] = float(coo[row, 1])
    return S


def _physical_mask(wfn, K, n_si, s=0):
    """State I is physical iff every natural occupation lies within
    [-PENALTY_TOL, 2 + PENALTY_TOL]. Mirrors zvalide/test.py so the ctest
    physical-state set is identical to the one stored in REF. Without per-state
    nat-occ every state is physical."""
    name = _sec_name(s, f"SSR NATURAL OCCUPATIONS K={K}")
    if not wfn.has_array_variable(name):
        return [True] * n_si
    occ = wfn.array_variable(name).np
    mask = []
    for I in range(occ.shape[0]):
        n_min = float(occ[I].min())
        n_max = float(occ[I].max())
        mask.append((n_min >= -PENALTY_TOL) and (n_max <= 2.0 + PENALTY_TOL))
    return mask


def _read_fon_block(wfn, val_name, meta_name, prefix):
    if not wfn.has_array_variable(val_name):
        return {}
    vals = wfn.array_variable(val_name).np.flatten()
    if not wfn.has_array_variable(meta_name):
        return {f"{prefix}_g{g}": float(vals[g]) for g in range(len(vals))}
    meta = wfn.array_variable(meta_name).np  # (3, N)
    out = {}
    for g in range(len(vals)):
        scheme = int(round(meta[0, g]))
        p = int(round(meta[1, g]))
        q = int(round(meta[2, g]))
        out[f"{prefix}{scheme}_{p}_{q}"] = float(vals[g])
    return out


def _collect_fons(wfn):
    fon = {}
    fon.update(_read_fon_block(wfn, "REKS FON", "REKS FON META", "n"))
    fon.update(_read_fon_block(wfn, "REKS M_FON", "REKS M_FON META", "m"))
    for K in _si_K_list(wfn):
        fon.update(_read_fon_block(wfn, f"REKS FON K={K}", f"REKS FON META K={K}", "n"))
        fon.update(_read_fon_block(wfn, f"REKS M_FON K={K}", f"REKS M_FON META K={K}", "m"))
    # sectors s>0: qualified "REKS SECTOR s <tail>", keys carry s{s}_ prefix.
    _nsec = _n_sectors(wfn)
    _GENS = [("REKS FON", "n"), ("REKS M_FON", "m"), ("REKS U_FON", "u"),
             ("REKS V_FON", "v"), ("REKS W_FON", "w")]
    for s in range(1, _nsec):
        for base, pfx in _GENS:
            nm = _sec_name(s, base)
            fon.update(_read_fon_block(wfn, nm, nm + " META", _sec_pfx(s, pfx)))
    for K in _si_K_list(wfn):
        s = _sector_of_K(wfn, K, _nsec)
        if s == 0:
            continue
        for base, pfx in _GENS:
            nm = _sec_name(s, f"{base} K={K}")
            mt = _sec_name(s, f"{base} META K={K}")
            fon.update(_read_fon_block(wfn, nm, mt, _sec_pfx(s, pfx)))
    return fon


def _collect_e_si(wfn):
    out = {}
    n_sec = _n_sectors(wfn)
    for K in _si_K_list(wfn):
        s = _sector_of_K(wfn, K, n_sec)
        name = _sec_name(s, f"SSR ENERGIES K={K}")
        if not wfn.has_array_variable(name):
            continue
        E = wfn.array_variable(name).np.flatten()
        n_si = len(E)
        mask = _physical_mask(wfn, K, n_si, s)
        for I in range(n_si):
            if mask[I]:
                out[f"K{K}_S{I}"] = float(E[I])
    return out


def _n_active(wfn):
    if wfn.has_scalar_variable("REKS N ACTIVE ORBITALS"):
        return int(round(wfn.scalar_variable("REKS N ACTIVE ORBITALS")))
    return 0


def _state_array(wfn, s, base, k, K):
    nm = _sec_name(s, f"{base} STATE={k} K={K}")
    if not wfn.has_array_variable(nm):
        return None
    return wfn.array_variable(nm).np


def _collect_meta(wfn):
    out = {}
    for k, label in (
        ("REKS N ACTIVE ELECTRONS", "n_act_e"),
        ("REKS N ACTIVE ORBITALS",  "n_act_o"),
        ("REKS SCHEME",             "scheme"),
        ("REKS G",                  "g"),
        ("REKS W_PPS",              "w_pps"),
        ("REKS N SECTORS",          "n_sec"),
    ):
        if wfn.has_scalar_variable(k):
            out[label] = float(wfn.scalar_variable(k))
    if wfn.has_array_variable("REKS SA_WEIGHTS"):
        saw = wfn.array_variable("REKS SA_WEIGHTS").np.flatten()
        for i in range(len(saw)):
            out[f"saw_{i}"] = float(saw[i])
    n_sec = _n_sectors(wfn)
    for K in _si_K_list(wfn):
        s = _sector_of_K(wfn, K, n_sec)
        out[f"K{K}_sector"] = float(s)
        nm = _sec_name(s, f"REKS NCORE K={K}")
        if wfn.has_array_variable(nm):
            out[f"K{K}_ncore"] = float(wfn.array_variable(nm).np.flatten()[0])
    return out


def _collect_postscf_inv(wfn):
    """Deviations of the postSCF identities, each zero by construction.

    Ties the gauge-dependent arrays (SI eigenvectors, natural orbitals, RDMs)
    to gauge-free data, so an indexing or striding regression moves an entry
    from ~1e-14 to O(1). Their own values cannot be compared: the eigenvector
    sign, the degenerate-subspace rotation and the active-MO sign are arbitrary.
    """
    out = {}
    n_sec = _n_sectors(wfn)
    N = _n_active(wfn)
    n_act_e = (float(wfn.scalar_variable("REKS N ACTIVE ELECTRONS"))
               if wfn.has_scalar_variable("REKS N ACTIVE ELECTRONS") else None)
    S_ao = wfn.S().np
    eye = np.eye(N) if N > 0 else None

    for K in _si_K_list(wfn):
        s = _sector_of_K(wfn, K, n_sec)
        pfx = f"K{K}"

        nmC = _sec_name(s, f"SSR COEFFICIENTS K={K}")
        nmH = _sec_name(s, f"SSR HAMILTONIAN K={K}")
        nmE = _sec_name(s, f"SSR ENERGIES K={K}")
        if all(wfn.has_array_variable(x) for x in (nmC, nmH, nmE)):
            C = wfn.array_variable(nmC).np
            H = wfn.array_variable(nmH).np
            S = _si_overlap(wfn, s, K, H.shape[0])
            E = wfn.array_variable(nmE).np.flatten()
            if S is None:
                continue
            mask = _physical_mask(wfn, K, len(E), s)
            d_norm = 0.0
            d_res = 0.0
            for I in range(min(C.shape[0], len(E))):
                if not mask[I]:
                    continue
                c = C[I]
                Sc = S @ c
                d_norm = max(d_norm, abs(float(c @ Sc) - 1.0))
                d_res = max(d_res, float(np.linalg.norm(H @ c - E[I] * Sc)))
            out[pfx + "_cSc"] = d_norm
            out[pfx + "_resid"] = d_res

        occ_nm = _sec_name(s, f"SSR NATURAL OCCUPATIONS K={K}")
        if N > 0 and wfn.has_array_variable(occ_nm):
            occ = wfn.array_variable(occ_nm).np
            n_si = occ.shape[0]
            mask = _physical_mask(wfn, K, n_si, s)
            adiab_nm = _sec_name(s, f"SSR 1-RDM ADIABATIC K={K}")
            adiab = (wfn.array_variable(adiab_nm).np
                     if wfn.has_array_variable(adiab_nm) else None)
            n_ad = int(round(adiab.shape[0] ** 0.5)) if adiab is not None else 0
            d_u = d_ud = d_ao = d_tr = d_ad = -1.0
            for k in range(n_si):
                if not mask[k]:
                    continue
                U = _state_array(wfn, s, "SSR NATURAL ORBITALS ACTIVE", k, K)
                rho = _state_array(wfn, s, "SSR 1-RDM ACTIVE", k, K)
                C_no = _state_array(wfn, s, "SSR NATURAL ORBITALS AO", k, K)
                if U is not None:
                    d_u = max(d_u, float(np.linalg.norm(U.T @ U - eye)))
                    if rho is not None:
                        d_ud = max(d_ud,
                                   float(np.linalg.norm(rho @ U - U * occ[k])))
                if C_no is not None:
                    d_ao = max(d_ao,
                               float(np.linalg.norm(C_no.T @ S_ao @ C_no - eye)))
                if rho is not None:
                    if n_act_e is not None:
                        d_tr = max(d_tr, abs(float(np.trace(rho)) - n_act_e))
                    if adiab is not None and k < n_ad:
                        blk = adiab[k * n_ad + k].reshape(N, N)
                        d_ad = max(d_ad, float(np.linalg.norm(blk - rho)))
            for label, v in (("_uOrtho", d_u), ("_uDiag", d_ud),
                             ("_aoOrtho", d_ao), ("_rhoTr", d_tr),
                             ("_adiabD", d_ad)):
                if v >= 0.0:
                    out[pfx + label] = v

        nmP = _sec_name(s, f"SSR PERMANENT DIPOLES K={K}")
        nmD = _sec_name(s, f"SSR DIFFERENCE DIPOLES K={K}")
        if wfn.has_array_variable(nmP) and wfn.has_array_variable(nmD):
            mu = wfn.array_variable(nmP).np
            dd = wfn.array_variable(nmD).np
            d_md = 0.0
            for I in range(1, min(mu.shape[0], dd.shape[0] + 1)):
                for c in range(3):
                    d_md = max(d_md,
                               abs(float(mu[I, c] - mu[0, c] - dd[I - 1, c])))
            out[pfx + "_muDiff"] = d_md
    return out


def run_point(R, mode, prev_backup):
    psi4.core.set_output_file(
        os.path.join(OUT_DIR, f"{mode}_R{R:.4f}.out"), False
    )
    mol = make_mol(R)
    opts = dict(OPTS)
    if mode == "read" and prev_backup is not None:
        prefix = psi4.core.get_writer_file_prefix(mol.name())
        fname = os.path.basename(os.path.abspath(prefix))
        scratch = psi4.core.IOManager.shared_object().get_default_path()
        shutil.copy2(prev_backup, os.path.join(scratch, fname + ".180.npy"))
        opts["guess"] = "read"
    else:
        opts["guess"] = "sad"
    psi4.set_options(opts)
    if any(OPTS.get("si_reks_grad", [])):
        # SI-gradient test: gradient() routes to the analytic per-state
        # response gradient (SI_REKS_GRAD orders). E_sa stays the ensemble.
        G, wfn = psi4.gradient(FUNCTIONAL, return_wfn=True)
        E = wfn.scalar_variable("SCF TOTAL ENERGY")
        grad = {}
        for a in range(G.rows(0)):
            for x, ax in enumerate("xyz"):
                grad[f"a{a}_{ax}"] = float(G.get(a, x))
    else:
        E, wfn = psi4.energy(FUNCTIONAL, return_wfn=True)
        grad = {}
    rec = {
        "E_sa":   float(E),
        "n_iter": int(wfn.iteration_),
        "fon":    _collect_fons(wfn),
        "E_si":   _collect_e_si(wfn),
        "meta":   _collect_meta(wfn),
        "postscf_inv": _collect_postscf_inv(wfn),
    }
    if grad:
        rec["grad"] = grad
    src_npy = wfn.get_scratch_filename(180) + ".npy"
    backup = None
    if os.path.exists(src_npy):
        backup = os.path.join(OUT_DIR, f"backup_R{R:.4f}.180.npy")
        shutil.copy2(src_npy, backup)
    return rec, backup


def _check(prefix, rec, ref):
    if "E_sa" in ref:
        compare_values(ref["E_sa"], rec["E_sa"], ATOL_E, f"{prefix} E_sa")  #TEST
    if "n_iter" in ref and rec["n_iter"] > ref["n_iter"] + 10:
        raise AssertionError(
            f"{prefix} n_iter regression: {rec['n_iter']} > ref {ref['n_iter']} + 10"
        )
    for k, v in ref.get("fon", {}).items():
        got = rec["fon"].get(k)
        if got is None:
            raise AssertionError(f"{prefix} fon[{k}] missing")
        compare_values(v, got, ATOL_FON, f"{prefix} fon[{k}]")  #TEST
    ref_e_si = ref.get("E_si", {})
    for k, v in ref_e_si.items():
        got = rec["E_si"].get(k)
        if got is None:
            raise AssertionError(f"{prefix} E_si[{k}] missing")
        compare_values(v, got, ATOL_E_SI, f"{prefix} E_si[{k}]")  #TEST
    for k, v in ref.get("grad", {}).items():
        got = rec.get("grad", {}).get(k)
        if got is None:
            raise AssertionError(f"{prefix} grad[{k}] missing")
        compare_values(v, got, ATOL_GRAD, f"{prefix} grad[{k}]")  #TEST
    for k, v in ref.get("meta", {}).items():
        got = rec["meta"].get(k)
        if got is None:
            raise AssertionError(f"{prefix} meta[{k}] missing")
        compare_values(v, got, ATOL_S, f"{prefix} meta[{k}]")  #TEST
    # Identity deviations: zero by construction, so the reference value is the
    # floor and any indexing regression lands orders of magnitude above it.
    for k, v in ref.get("postscf_inv", {}).items():
        got = rec["postscf_inv"].get(k)
        if got is None:
            raise AssertionError(f"{prefix} postscf_inv[{k}] missing")
        compare_values(v, got, ATOL_INV, f"{prefix} postscf_inv[{k}]")  #TEST
    # Set equality: no extra physical SI state may appear (rank-increase
    # regression). rec E_si uses the same penalty filter as REF, so any key in
    # rec but not REF is a genuinely new physical eigenstate, not a sentinel.
    for k in rec["E_si"]:
        if k not in ref_e_si:
            raise AssertionError(
                f"{prefix} E_si[{k}] unexpected: {rec['E_si'][k]:.8f} "
                f"(physical state absent from reference)"
            )


def main():
    prev_backup = None
    run_cold = "cold" in MODES
    run_read = "read" in MODES
    for i, R in enumerate(R_VALUES):
        R_key = f"R={R:.4f}"
        backup = None
        if run_cold:
            psi4.core.clean()
            rec, backup = run_point(R, "cold", None)
            cold_ref = REF.get("cold", {}).get(R_key)
            if cold_ref is not None:
                _check(f"cold/{R_key}", rec, cold_ref)
        if run_read and i > 0 and prev_backup is not None:
            psi4.core.clean()
            rec2, _ = run_point(R, "read", prev_backup)
            read_ref = REF.get("read", {}).get(R_key)
            if read_ref is not None:
                _check(f"read/{R_key}", rec2, read_ref)
        prev_backup = backup
    psi4.core.clean()


main()
