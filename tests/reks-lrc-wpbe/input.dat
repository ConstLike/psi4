#! Manual test -- not generated by zvalide.
#! Test: reks-lrc-wpbe
#! REKS(2,2)/6-31G/wPBE on H2. wPBE is range-separated with x_alpha = 0, so it is
#! NOT a hybrid: the Fock build asks the JK object for wK and no K at all. Two
#! invariants only this functional class reaches:
#!   (1) the SA Fock JK cache reads only the JK outputs the Fock asked for, so an
#!       absent K is never indexed and wK is never read as if it were K.
#!   (2) GVB-DIIS curvature needs the pair integrals (pk|pk), which build_jk_cache
#!       supplies on demand from the active columns. The accelerator sits in the
#!       step denominator alone, so it reaches the same E_sa as the plain path.
import psi4

REF_E_SA = -0.9068788516047459  #TEST
ATOL_E = 1.0e-7  #TEST

OPTS = {
    'basis': '6-31g',
    'scf_type': 'pk',
    'reference': 'reks',
    'df_scf_guess': False,
    'maxiter': 50,
    'e_convergence': 8,
    'd_convergence': 6,
    'dft_grid_name': 'SG1',
    'guess': 'SAD',
    'reks': [2, 2],
    'reks_sa_weights': [0.5, 0.5],
    'reks_diis_formulation': 'ORBITAL',
    'reks_report_level': 4,
    'fail_on_maxiter': False,
}


def make_mol():
    return psi4.geometry("""
    0 1
    H  0.0  0.0  0.0
    H  0.0  0.0  1.600000
    symmetry c1
    no_com
    no_reorient
    """)


# (1) plain REKS with a non-hybrid LRC functional converges.
psi4.core.clean()
make_mol()
psi4.set_options(dict(OPTS, reks_gvb_diis=False))
e_sa = psi4.energy('wpbe')
compare_values(REF_E_SA, e_sa, ATOL_E, "wPBE REKS(2,2) E_sa")  #TEST

# (2) GVB-DIIS on the same functional reaches the same E_sa.
psi4.core.clean()
make_mol()
psi4.set_options(dict(OPTS, reks_gvb_diis=True))
e_sa_gvb = psi4.energy('wpbe')
compare_values(REF_E_SA, e_sa_gvb, ATOL_E, "wPBE REKS(2,2) E_sa, GVB-DIIS")  #TEST
psi4.core.clean()
