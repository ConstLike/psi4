GUESS = "reks_inputval_rhf.npy"
GUESS_TZ = "reks_inputval_rhf_tz.npy"
REFUSED = "Not supported for REFERENCE REKS: "


def reks_call(method='hf', fn=psi4.energy, **kwargs):
    return lambda mol: fn(method, molecule=mol, **kwargs)


# (label, opts, wanted substrings, call); H2, REKS [2, 2]
DRIVER_CASES = [
    ("d01_pcm", {'pcm': True}, [REFUSED + "PCM."], reks_call()),
    ("d02_ddx", {'ddx': True}, [REFUSED + "DDX."], reks_call()),
    ("d02b_pe", {'pe': True}, [REFUSED + "PE."], reks_call()),
    ("d03_double_hybrid", {}, [REFUSED + "double-hybrid functional B2PLYP."], reks_call('b2plyp')),
    ("d04_mom", {'mom_start': 3}, [REFUSED + "MOM_START."], reks_call()),
    ("d05_frac", {'frac_start': 3}, [REFUSED + "FRAC_START."], reks_call()),
    ("d06_damping", {'damping_percentage': 20.0}, [REFUSED + "DAMPING_PERCENTAGE."], reks_call()),
    ("d07_stability", {'stability_analysis': 'check'}, [REFUSED + "STABILITY_ANALYSIS."], reks_call()),
    ("d08_tdscf", {'tdscf_states': [2]}, [REFUSED + "TDSCF_STATES."], reks_call()),
    ("d09_vv10", {}, [REFUSED + "VV10 nonlocal correlation (WB97X-V)."], reks_call('wb97x-v')),
    ("d09b_grac", {'dft_grac_shift': 0.1}, [REFUSED + "DFT_GRAC_SHIFT."], reks_call('pbe')),
    ("d10_all_listed", {'mom_start': 3, 'damping_percentage': 20.0},
     [REFUSED + "MOM_START, DAMPING_PERCENTAGE."], reks_call()),
    ("d11_post_scf", {}, ["REFERENCE REKS is a complete calculation and is not a reference for post-SCF"],
     reks_call('dct')),
    ("d12_gradient_analytic", {}, ["not available for target derivative level", "REFERENCE=REKS"],
     reks_call(fn=psi4.gradient, dertype=1)),
    ("d13_hessian_analytic", {}, ["not available for target derivative level", "REFERENCE=REKS"],
     reks_call(fn=psi4.hessian, dertype=2)),
    ("d14_read_no_file", {'guess': 'read'}, ["REKS GUESS=READ: no saved orbitals to read"], reks_call()),
    ("d15_window_needs_read", {'guess_active_window': ['HOMO', 'LUMO']},
     ["GUESS_ACTIVE_WINDOW reorders the orbitals taken from the READ guess and needs GUESS READ"],
     reks_call()),
    ("d16_window_length", {'guess_active_window': ['HOMO']},
     ["GUESS_ACTIVE_WINDOW lists 1 orbitals but the active space holds 2"],
     reks_call(restart_file=GUESS)),
    ("d17_window_token", {'guess_active_window': ['HOMO', 'LUMOX']},
     ["GUESS_ACTIVE_WINDOW bad token: 'LUMOX'"], reks_call(restart_file=GUESS)),
    ("d18_window_range", {'guess_active_window': ['HOMO', 'LUMO+20']},
     ["entry 'LUMO+20' resolves to MO 21, outside the 4 orbitals"], reks_call(restart_file=GUESS)),
    ("d19_window_repeat", {'guess_active_window': ['HOMO', 'HOMO']},
     ["GUESS_ACTIVE_WINDOW names MO [0] more than once"], reks_call(restart_file=GUESS)),
    ("d20_read_puream", {'basis': 'cc-pvtz', 'puream': False},
     ["the saved orbitals have 28 basis-function rows", "Use the PUREAM of the source calculation"],
     reks_call(restart_file=GUESS_TZ)),
]


def run_case(label, opts, wants, mol, mult, call=reks_call()):
    psi4.core.clean()
    psi4.core.clean_options()
    active = psi4.geometry(f"0 {mult}\n{mol}")
    o = dict(BASE)
    o.update(opts)
    try:
        psi4.set_options(o)
        call(active)
    except Exception as e:
        msg = str(e)
        low = msg.lower()
        for want in wants:
            hit = want.lower() in low
            if not hit:
                flat = " | ".join(msg.strip().splitlines())
                print(f"@@ {label}: MISSING SUBSTRING {want!r} in: {flat[:400]}")
            compare_integers(1, int(hit), f"{label}: message carries {want!r}")  #TEST
    else:
        print(f"@@ {label}: NO ERROR RAISED (fail-open)")
        compare_integers(1, 0, f"{label}: raises")  #TEST


for label, opts, wants, mol, mult in CASES:
    run_case(label, opts, wants, mol, mult)

psi4.core.clean()
psi4.core.clean_options()
rhf_molecule = psi4.geometry(f"0 1\n{H2_FRAME}", name="rhf_guess")
psi4.set_options({'basis': BASE['basis'], 'scf_type': 'pk', 'reference': 'rhf'})
rhf_wfn = psi4.energy('hf', molecule=rhf_molecule, return_wfn=True)[1]
rhf_wfn.to_file(GUESS)
psi4.set_options({'basis': 'cc-pvtz'})
psi4.energy('hf', molecule=rhf_molecule, return_wfn=True)[1].to_file(GUESS_TZ)

for label, opts, wants, call in DRIVER_CASES:
    run_case(label, dict({'reks': [2, 2]}, **opts), wants, H2_FRAME, 1, call)
