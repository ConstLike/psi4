#! REKS input validation: malformed options and unsupported features raise with specific messages

import psi4

BASE = {
    'basis': '6-31g(d)', 'scf_type': 'pk', 'reference': 'reks',
    'reks_report_level': 2, 'guess': 'sad', 'reks_use_trah': True,
}


def chain(symbol, n, c1=True):
    lines = [f"{symbol} 0.0 0.0 {i * 1.6:.6f}" for i in range(n)]
    return "\n".join(lines + (["symmetry c1"] if c1 else []))


H2 = chain("H", 2)
H4 = chain("H", 4)
HE2 = chain("He", 2)
H2_D2H = chain("H", 2, c1=False)
H2_FRAME = H2 + "\nno_com\nno_reorient"

